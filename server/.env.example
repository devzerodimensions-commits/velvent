# ---- Database (Neon) -------------------------------------------------------
# Neon dashboard -> your project -> Connection string -> "Pooled connection"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ------------------------------------------------------------------
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Seed admin account ----------------------------------------------------
ADMIN_EMAIL=admin@velvent.in
ADMIN_PASSWORD=change-this-password

# ---- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Payments (optional) ---------------------------------------------------
# Leave blank to run Cash-on-Delivery only. Add keys to switch online payment on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# How Postgres is reached: off | on | verify.
#   off     same machine or private network, nothing to encrypt against
#   on      encrypt, do not check the certificate (Neon, Render, most managed hosts)
#   verify  encrypt and check it too — right over the open internet
# Unset, it guesses: no TLS for localhost, TLS without verification otherwise.
DATABASE_SSL=

# Where uploaded images live: database | disk.
#   database  for a host with no persistent disk, such as Render, where
#             anything written to the filesystem is gone on the next deploy
#   disk      for a server with real storage — keeps image bytes out of
#             every database backup
# After changing this, run: npm run media:move -- --to disk
MEDIA_STORE=

# Where disk storage writes. Defaults to ./uploads beside the server.
MEDIA_DIR=

# Which courier books parcels. Only `manual` exists today: someone enters
# the tracking number the courier gave them.
SHIPPING_PROVIDER=
