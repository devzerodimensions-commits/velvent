# ---- Database (Neon) -------------------------------------------------------
# Neon dashboard -> your project -> Connection string -> "Pooled connection"
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Auth ------------------------------------------------------------------
# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Seed admin account ----------------------------------------------------
ADMIN_EMAIL=admin@velvent.in
ADMIN_PASSWORD=change-this-password

# ---- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Payments (optional) ---------------------------------------------------
# Leave blank to run Cash-on-Delivery only. Add keys to switch online payment on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
