{
  "name": "velvent",
  "version": "1.0.0",
  "private": true,
  "description": "VELVENT \u2014 premium knitwear e-commerce store",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix server install && npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "db:setup": "npm --prefix server run db:setup",
    "db:seed": "npm --prefix server run db:seed",
    "smoke": "npm --prefix server run smoke --"
  }
}
