# Copy to .env beside docker-compose.yml, fill in, then:
#   docker compose up -d --build

# --- required ---------------------------------------------------------------

# Postgres password for the database container. Anything long and random.
POSTGRES_PASSWORD=

# Signs the tokens that keep an admin logged in. Change this and everyone is
# signed out, which is the quickest way to end a session you did not expect.
#   openssl rand -base64 48
JWT_SECRET=

# --- the first admin --------------------------------------------------------
# Only used the first time the database is seeded. Afterwards, accounts are
# managed in the panel under Users.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- optional ---------------------------------------------------------------

# Database name and user inside the container. The defaults are fine.
# POSTGRES_USER=velvent
# POSTGRES_DB=velvent

# Where the store answers on the host. Put a reverse proxy in front of this
# for TLS — the container speaks plain HTTP on purpose.
# APP_PORT=10000

# Needed only when the storefront is served from a different origin to the
# API. In this setup it is not, so leave it empty.
# CLIENT_ORIGIN=https://velvent.in

# Online payment. Leave empty for cash on delivery only.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
